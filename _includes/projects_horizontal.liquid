{% if project.redirect %}
  {% assign project_url = project.redirect %}
  {% assign project_link_attributes = 'target="_blank" rel="external nofollow noopener"' %}
{% else %}
  {% assign project_url = project.url | relative_url %}
  {% assign project_link_attributes = '' %}
{% endif %}

<div class="col mb-4">
  <div class="card h-100 hoverable">
    <div class="row no-gutters{% unless project.img %} project-no-image{% endunless %}">
      {% if project.img %}
        <div class="project-thumb-col">
          <a class="project-card-link" href="{{ project_url }}" {{ project_link_attributes }}>
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 280px, 100vw" alt="project thumbnail" class="card-img" %}
          </a>
        </div>
      {% endif %}
      <div class="project-content-col">
        <div class="card-body">
          <a class="project-card-link" href="{{ project_url }}" {{ project_link_attributes }}>
            <h3 class="card-title">{{ project.title }}</h3>
            <p class="card-text">{{ project.description }}</p>
          </a>
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}" target="_blank" rel="external nofollow noopener" aria-label="Code repository">
                  <i class="fa-brands fa-github gh-icon"></i>
                </a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
