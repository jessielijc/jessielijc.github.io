<section class="honors-section">
  <div class="section-heading refined">
    <div>
      <h2>Awards</h2>
    </div>
  </div>

  <div class="honors-list refined">
    <article class="honor-card refined">
      <figure class="honor-photo">
        <img
          src="{{ '/assets/img/awards/robocon-2024/team-photo.jpg' | relative_url }}"
          alt="SUSTech team at the 2024 ROBOCON China Championship"
          loading="lazy"
        >
      </figure>
      <div class="honor-content">
        <div class="honor-meta">
          <span class="honor-year">2024</span>
          <span class="honor-type">National Competition</span>
        </div>
        <h3>ROBOCON China Championship 2024</h3>
        <p class="honor-description">
          At the 23rd China University Robot Competition ROBOCON, I competed as a member of the SUSTech team in the Grain Storage and Biomimetic
          Legged Robot events. Our team received five awards across the operation challenge, theme contest, indoor sprint, indoor obstacle, and
          innovation categories.
        </p>
        <ul class="honor-awards">
          <li><strong>National First Prize</strong> — Grain Storage Operation Challenge</li>
          <li><strong>National Second Prize</strong> — Grain Storage Theme Contest</li>
          <li><strong>National Third Prize</strong> — Biomimetic Legged Robot Indoor Sprint</li>
          <li><strong>National Third Prize</strong> — Biomimetic Legged Robot Indoor Obstacle</li>
          <li><strong>Innovation Award</strong> — Biomimetic Legged Robot Challenge</li>
        </ul>
      </div>

      <details class="award-disclosure">
        <summary>
          <span class="show-label">Show Awards</span>
          <span class="hide-label">Hide Awards</span>
        </summary>
        <div class="award-gallery">
          <figure class="award-certificate">
            <a
              href="{{ '/assets/img/awards/robocon-2024/certificate-operation-challenge.png' | relative_url }}"
              target="_blank"
              rel="noopener"
              aria-label="Open the National First Prize certificate at full size"
            >
              <span class="award-image-frame">
                <img
                  src="{{ '/assets/img/awards/robocon-2024/certificate-operation-challenge.png' | relative_url }}"
                  alt="National First Prize certificate for the Grain Storage Operation Challenge"
                  loading="lazy"
                >
              </span>
            </a>
            <figcaption>National First Prize · Operation Challenge</figcaption>
          </figure>

          <figure class="award-certificate">
            <a
              href="{{ '/assets/img/awards/robocon-2024/certificate-theme-contest.png' | relative_url }}"
              target="_blank"
              rel="noopener"
              aria-label="Open the National Second Prize certificate at full size"
            >
              <span class="award-image-frame">
                <img
                  src="{{ '/assets/img/awards/robocon-2024/certificate-theme-contest.png' | relative_url }}"
                  alt="National Second Prize certificate for the Grain Storage Theme Contest"
                  loading="lazy"
                >
              </span>
            </a>
            <figcaption>National Second Prize · Theme Contest</figcaption>
          </figure>

          <figure class="award-certificate">
            <a
              href="{{ '/assets/img/awards/robocon-2024/certificate-indoor-sprint.png' | relative_url }}"
              target="_blank"
              rel="noopener"
              aria-label="Open the Indoor Sprint National Third Prize certificate at full size"
            >
              <span class="award-image-frame">
                <img
                  src="{{ '/assets/img/awards/robocon-2024/certificate-indoor-sprint.png' | relative_url }}"
                  alt="National Third Prize certificate for the Biomimetic Legged Robot Indoor Sprint"
                  loading="lazy"
                >
              </span>
            </a>
            <figcaption>National Third Prize · Indoor Sprint</figcaption>
          </figure>

          <figure class="award-certificate">
            <a
              href="{{ '/assets/img/awards/robocon-2024/certificate-indoor-obstacle.png' | relative_url }}"
              target="_blank"
              rel="noopener"
              aria-label="Open the Indoor Obstacle National Third Prize certificate at full size"
            >
              <span class="award-image-frame">
                <img
                  src="{{ '/assets/img/awards/robocon-2024/certificate-indoor-obstacle.png' | relative_url }}"
                  alt="National Third Prize certificate for the Biomimetic Legged Robot Indoor Obstacle"
                  loading="lazy"
                >
              </span>
            </a>
            <figcaption>National Third Prize · Indoor Obstacle</figcaption>
          </figure>

          <figure class="award-certificate">
            <a
              href="{{ '/assets/img/awards/robocon-2024/certificate-innovation.png' | relative_url }}"
              target="_blank"
              rel="noopener"
              aria-label="Open the Biomimetic Legged Robot Innovation Award certificate at full size"
            >
              <span class="award-image-frame">
                <img
                  class="award-image-rotated"
                  src="{{ '/assets/img/awards/robocon-2024/certificate-innovation.png' | relative_url }}"
